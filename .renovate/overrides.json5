{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Override Helmfile Dependency Name",
      matchDatasources: [
        "docker"
      ],
      matchManagers: [
        "helmfile"
      ],
      overrideDepName: "{{packageName}}",
    },
    {
      "description": "Separate Major/Minor/Patch for CNPG PostgreSQL image upgrades",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/cloudnative-pg/postgresql"
      ],
      "separateMajorMinor": true,
      "separateMinorPatch": true,
      "separateMultipleMajor": true,
      "separateMultipleMinor": true
    },
    {
      description: [
        "TimescaleDB extension: skip the releases that break background jobs on PostgreSQL 18.7",
        "(timescale/timescaledb#11038); the containers repo still builds them. See docs/cnpg-timescaledb-extension-upgrade.md.",
      ],
      matchDatasources: [
        "docker"
      ],
      matchPackageNames: [
        "ghcr.io/mrdynamo/timescaledb-bridge"
      ],
      allowedVersions: "!/^2\\.3[01]\\.\\d+$|^2\\.32\\.0$/",
    },
    {
      description: "Ignore Rancher shell images >= 7.0.0",
      matchDatasources: [
        "docker"
      ],
      matchPackageNames: [
        "docker.io/rancher/shell"
      ],
      allowedVersions: "<7.0.0",
    },
    {
      description: "Ignore Prompp images >= 3.0.0",
      matchDatasources: [
        "docker"
      ],
      matchPackageNames: [
        "ghcr.io/deckhouse/prompp"
      ],
      allowedVersions: "<3.0.0",
    },
    // {
    //   // Handle Dispatcharr tags
    //   // https://docs.renovatebot.com/modules/versioning/regex/
    //   matchDatasources: [
    //     "docker"
    //   ],
    //   matchPackageNames: [
    //     "ghcr.io/dispatcharr/dispatcharr"
    //   ],
    //   versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<build>\\d+)$",
    // },
    {
      // Handle EnhancedChannelManager tags
      // https://docs.renovatebot.com/modules/versioning/regex/
      matchDatasources: [
        "docker"
      ],
      matchPackageNames: [
        "ghcr.io/motwakorb/enhancedchannelmanager",
        "ghcr.io/motwakorb/enhancedchannelmanager-mcp"
      ],
      versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<build>[0-9A-Za-z.-]+)$",
    },
    {
      // Handle Tracearr (Dispatcharr fork) tags
      // https://docs.renovatebot.com/modules/versioning/regex/
      matchDatasources: [
        "docker"
      ],
      matchPackageNames: [
        "ghcr.io/d4rk-4lchemy/distracearr"
      ],
      versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(-r(?<build>\\d+))?$",
    },
    {
      // Handle Apache Tika tags (e.g. 3.3.3.0-full and 4.2.0-full)
      // Tika moved from four-part (3.3.3.0) to three-part (4.0.0) versions. Renovate's default
      // docker versioning only considers tags with the same number of version segments, so it
      // silently skipped every 4.x tag. The optional build group accepts both formats, and the
      // suffix is captured as "compatibility" so only "-full" tags are ever proposed.
      // https://docs.renovatebot.com/modules/versioning/regex/
      matchDatasources: [
        "docker"
      ],
      matchPackageNames: [
        "docker.io/apache/tika"
      ],
      versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(\\.(?<build>\\d+))?-(?<compatibility>[a-z0-9.-]+)$",
      // Paperless-ngx doesn't support Tika 4.x yet, so skip the 4.x train (3.x updates still flow).
      // A negated regex, not a "<4.0.0" range: regex versioning has no range support and would
      // fall back to npm semver.
      allowedVersions: "!/^4\\./",
    },
    {
      // Handle nginx-unprivileged tags (e.g. 1.27.4-alpine)
      // The suffix is captured as "compatibility" so Renovate only proposes
      // tags with the same suffix, and never swaps the image variant
      // (alpine -> alpine-slim, or the plain non-alpine tag).
      // https://docs.renovatebot.com/modules/versioning/regex/
      matchDatasources: [
        "docker"
      ],
      matchPackageNames: [
        "ghcr.io/nginxinc/nginx-unprivileged"
      ],
      versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<compatibility>[a-z0-9.-]+)$",
    },
  ],
}
